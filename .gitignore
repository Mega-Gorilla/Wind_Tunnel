# Credentials, host-specific access, runtime state (keep these locally).
.local/
.env
.env.*
!.env.example
**/.runtime/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
*known_hosts*
/Docs/operations/SSH_CONNECTION.md
/measurements/network_*/
/measurements/pi32_admin_*.json
/measurements/pi32_preflight_*.json

# Installed applications, vendor checkouts, interpreters and caches.
/external/
/Raspberry Pi Imager/
/tools/imaging/
/Archive/
/tmp/
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
*.py[cod]
**/test-results/
.DS_Store
Thumbs.db
Desktop.ini

# KiCad editable sources/libraries/manufacturing outputs ARE tracked.
*.kicad_prl
fp-info-cache
*.lck
~*.lck
*-backups/
*.bak
*.tmp

# CFD software, generated meshes and volume fields remain on this PC.
# Preserve case settings, compact provenance and final reports in Git.
/analysis/*/tools/
/analysis/*/downloads/
/analysis/*/meshes/
/analysis/*/cases/*/*
!/analysis/*/cases/*/system/
!/analysis/*/cases/*/system/**
!/analysis/*/cases/*/constant/
/analysis/*/cases/*/constant/*
!/analysis/*/cases/*/constant/transportProperties
!/analysis/*/cases/*/constant/turbulenceProperties
!/analysis/*/cases/*/case_metadata.json
!/analysis/*/cases/*/mesh_diagnostic_acceptance.json

# Machine-specific dependency inspection / transient renders.
*.inspect.ndjson

# Public edition: local instructions, migration logs and vendor references.
/AGENTS.md
/tools/maintenance/
/Docs/maintenance/*
!/Docs/maintenance/publication-review/
/Docs/archive/
/Docs/references/
/Docs/research/wind-tunnel-20261018/ui-references/
/Docs/procurement/misumi-psu-v49/build_parts_list.mjs

# Publish the current independent electronics, not legacy diagnostic bundles.
/Electronics/*
!/Electronics/README.md
!/Electronics/pico/
!/Electronics/manufacturing/
!/Electronics/library-licenses/
/Electronics/pico/*
!/Electronics/pico/README.md
!/Electronics/pico/pcb_rev_e/
!/Electronics/pico/firmware/
!/Electronics/pico/diagnostics/

# Do not redistribute the official wind-tunnel CAD, including converted geometry.
# Our analysis code, settings, figures and numerical results remain publishable.
/analysis/*/geometry/*.stl
